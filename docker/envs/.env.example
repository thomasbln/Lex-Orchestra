# ─────────────────────────────────────────────────────────────
# Lex-Orchestra — Environment Reference
# Copy to docker/envs/.env and fill in every __SET_ME__ value.
# See docs/setup/docker.md for full documentation.
#
# What is active below is the sovereign profile: inference and graph both run
# on your machine, nothing leaves the network. That is the path the README
# quickstart documents, so it is the default here.
#   Requires: --profile with-ollama --profile with-neo4j
#   Recommended hardware: x86_64, 16 GB RAM or more
#
# To run against cloud services instead, see the alternative block further down.
# ─────────────────────────────────────────────────────────────

# ── LLM backend ──────────────────────────────────────────────
# local = Ollama container (bring your own model) · api = external cloud model
LLM_BACKEND=local
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=gemma4:e4b

# ── Neo4j backend ────────────────────────────────────────────
# local = bundled container · aura = Neo4j Aura · custom = your own instance
NEO4J_BACKEND=local
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=__SET_ME__
# Neo4j container auth — format: "neo4j/<password>" (must match NEO4J_PASSWORD)
NEO4J_AUTH=neo4j/__SET_ME__
# Neo4j container plugins + memory (injected directly, no compose interpolation)
NEO4J_PLUGINS=["apoc"]
NEO4J_server_memory_heap_initial__size=512m
NEO4J_server_memory_heap_max__size=1G
NEO4J_server_memory_pagecache_size=512m
# Required because the shared env file also contains app-level NEO4J_* vars
# (BACKEND, URI, USERNAME, PASSWORD, DATABASE) that Neo4j would otherwise
# reject as unknown config keys.
NEO4J_server_config_strict__validation_enabled=false
# In-network services reach the database at bolt://neo4j:7687. `make seed-all`
# runs on the host and uses bolt://localhost:7687 by default; override with
# NEO4J_LOCAL_URI if your container publishes a different port.

# ── Alternative: cloud LLM + Neo4j Aura instead of the local sovereign stack ──
# Uncomment and adjust, then set LLM_BACKEND=api and NEO4J_BACKEND=aura above.
# The working cloud backend in v1.0 is Anthropic; generic BYOK (any
# OpenAI-compatible endpoint) is planned but not wired yet. Running this way
# sends prompt content to a third party, so read docs/architecture/trust.md
# before you choose it.
#   ANTHROPIC_API_KEY=__SET_ME__
#   LLM_MODEL=claude-sonnet-4-6
#   NEO4J_URI=neo4j+s://__SET_ME__.databases.neo4j.io

# ── Supabase / PostgreSQL ─────────────────────────────────────
POSTGRES_PASSWORD=__SET_ME__
DATABASE_URL=postgresql://postgres:__SET_ME__@supabase-db:5432/postgres

# ── Network ───────────────────────────────────────────────────
# Host clients use to reach the dashboard: a LAN IP or hostname, not localhost,
# unless you only ever open it on the machine itself.
DASHBOARD_URL=http://__SET_ME__:3000
# Base URL for gap-hint deep-links in scan report (ADR-086).
# Leave the host as __SET_ME__ and the links in generated documents point nowhere.
DASHBOARD_BASE_URL=http://__SET_ME__:3000

# CORS (F24): unset = approve_api allows every PRIVATE-network origin
# (RFC 1918 + localhost + *.local) — LAN-only by design; the API is
# unauthenticated (see Security posture in docs/setup/docker.md). Set an
# explicit comma-separated origin list ONLY when exposing beyond the LAN —
# and read the security notes first. NEVER expose ports 8001/3000 publicly.
# CORS_ORIGINS=http://localhost:3000

# ── Scan Status Updates (ADR-068) ─────────────────────────────
# The pipeline PATCHes live step updates to approve_api — same container,
# so localhost is correct (also the code default; cleanroom F21).
APPROVE_API_URL=http://localhost:8001
# Shared secret guarding PATCH /scan/{run_id}/step. Empty = guard disabled
# (trusted-LAN default). Recommended: openssl rand -hex 32
SCAN_INTERNAL_SECRET=

# Scan lifecycle knobs (ADR-129 PR 7 / ADR-068)
SCAN_WAIT_TIMEOUT=1800      # seconds approve_api waits for a scan run
SCAN_REAPER_INTERVAL=600    # seconds between reaper sweeps for stuck 'running' scans
